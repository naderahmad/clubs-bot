# --- Discord (Developer Portal > tu aplicación) ---
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Servidor de pruebas y canal donde el bot publica resultados/recordatorios
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- EA Clubs ---
# Nombre exacto del club en FC 27 (para buscar el ID con `npm run test:ea`)
EA_CLUB_NAME=STARLINK FCX
# ID del club (lo obtienes con `npm run test:ea`)
EA_CLUB_ID=621507
EA_PLATFORM=common-gen5

# --- Reglas del club ---
# Zona horaria del club (Venezuela = -04:00)
CLUB_UTC_OFFSET=-04:00
# Roja si juega menos de este % del tiempo del que más jugó
LEAVER_THRESHOLD=0.75
# Horas después del inicio de la convocatoria en que se cuentan partidos
SESSION_WINDOW_HOURS=4

# --- Cron ---
# Cadena larga aleatoria; protege /api/cron/sync en Vercel (solo diagnóstico: el sync real corre en GitHub Actions)
CRON_SECRET=
